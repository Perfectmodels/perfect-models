# Supabase — primary database and authentication
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional public aliases only when direct browser Supabase access is explicitly needed.
# The PMM application normally talks to Supabase through Next.js server APIs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Firebase — migration / first-login bridge only. Remove after every legacy account has migrated.
NEXT_PUBLIC_FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_EXPORT_PATH=

# Vercel Blob / media
BLOB_READ_WRITE_TOKEN=
IMGBB_API_KEY=
GOOGLE_SITE_VERIFICATION=

# Public application settings
NEXT_PUBLIC_SITE_URL=https://www.perfectmodels.online
NEXT_PUBLIC_CHATBOT_ID=

# Optional analytics / advertising identifiers
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional integrations
VITE_RESEND_API_KEY=
VITE_FORMSPREE_ENDPOINT=
VITE_BREVO_API_KEY=
VITE_DROPBOX_APP_KEY=
VITE_DROPBOX_ACCESS_TOKEN=
VITE_GEMINI_API_KEY=
VITE_CHATBOT_ID=
DEFAULT_FROM_EMAIL=
BREVO_API_KEY=
