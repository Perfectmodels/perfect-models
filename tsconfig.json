{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "docs",
    "resources",
    "src/__tests__/**",
    "src/components/AIAssistantIcon.tsx",
    "src/components/ProtectedRoute.tsx",
    "src/components/ModelCard.tsx",
    "src/components/ServiceCard.tsx",
    "src/components/ModelCrossLinks.tsx",
    "src/components/BookingForm.tsx",
    "src/components/GalleryPage.tsx"
  ]
}
