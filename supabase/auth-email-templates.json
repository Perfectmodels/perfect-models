  "mailer_templates_identity_unlinked_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Méthode de connexion supprimée</h2><p style=\"color:#c8c2b7;line-height:1.7\">Le fournisseur <strong style=\"color:#c9a84c\">{{ .Provider }}</strong> a été retiré de votre compte {{ .Email }}.</p><div style=\"margin-top:24px;background:#120e0e;border-left:3px solid #c96f6f;padding:16px;border-radius:8px;color:#bbb;font-size:13px\">Si cette action ne vient pas de vous, vérifiez immédiatement les paramètres de sécurité de votre compte.</div></td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_mfa_factor_enrolled_enabled": true,
