  "mailer_templates_mfa_factor_enrolled_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Une nouvelle vérification a été ajoutée</h2><p style=\"color:#c8c2b7;line-height:1.7\">La méthode de sécurité <strong style=\"color:#c9a84c\">{{ .FactorType }}</strong> est maintenant active sur votre compte.</p><p style=\"color:#888;font-size:13px\">Cette protection supplémentaire contribue à sécuriser l’accès à votre espace PMM.</p></td></tr></table></td></tr></table></body></html>",

