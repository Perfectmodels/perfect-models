{
  "mailer_subjects_confirmation": "Confirmez votre adresse email — Perfect Models Management",
  "mailer_templates_confirmation_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><div style=\"display:none;max-height:0;overflow:hidden\">Confirmez votre adresse pour sécuriser et activer votre espace Perfect Models Management.</div><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:28px 34px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"Perfect Models Management\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div><div style=\"color:#777;font-size:11px;margin-top:8px\">Espace sécurisé</div></td></tr><tr><td style=\"padding:42px 38px 34px;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Activation du compte</div><h1 style=\"color:#fff;font-size:28px;line-height:1.2;margin:0 0 18px\">Confirmez votre adresse email</h1><p style=\"margin:0 0 18px;color:#d6d1c7\">Une dernière étape est nécessaire pour vérifier votre adresse et sécuriser l’accès à votre espace Perfect Models Management.</p><p style=\"margin:0 0 26px;color:#a8a39a;font-size:14px\">Cette validation nous permet de protéger votre compte et de nous assurer que les informations importantes vous parviennent à la bonne adresse.</p><p style=\"margin:30px 0;text-align:center\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c9a84c;color:#080808;text-decoration:none;font-weight:800;padding:15px 28px;border-radius:999px;letter-spacing:.3px\">Confirmer mon adresse email</a></p><div style=\"margin-top:30px;background:#101010;border:1px solid #222;border-left:3px solid #c9a84c;border-radius:10px;padding:18px 20px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px\">Sécurité</div><p style=\"margin:0;color:#aaa;font-size:13px;line-height:1.6\">Si vous n’avez pas créé ou demandé ce compte, vous pouvez ignorer cet email. Ne transférez jamais ce lien de confirmation.</p></div><p style=\"margin:28px 0 0;color:#777;font-size:11px;line-height:1.6;word-break:break-all\">Si le bouton ne fonctionne pas, utilisez ce lien :<br><a href=\"{{ .ConfirmationURL }}\" style=\"color:#c9a84c\">{{ .ConfirmationURL }}</a></p></td></tr><tr><td style=\"padding:24px 30px;text-align:center;background:#070707;border-top:1px solid #191919\"><p style=\"margin:0;color:#777;font-size:11px\">Perfect Models Management · Libreville, Gabon</p><p style=\"margin:7px 0 0;color:#555;font-size:10px\">Message automatique de sécurité — merci de ne pas y répondre.</p></td></tr></table></td></tr></table></body></html>",

  "mailer_subjects_invite": "Votre accès Perfect Models Management est prêt",
  "mailer_templates_invite_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><div style=\"display:none;max-height:0;overflow:hidden\">Votre espace Perfect Models Management vous attend.</div><table width=\"100%\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:30px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"PMM\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div></td></tr><tr><td style=\"padding:42px 38px;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Invitation personnelle</div><h1 style=\"color:#fff;font-size:28px;line-height:1.2;margin:0 0 18px\">Bienvenue dans votre espace PMM</h1><p style=\"color:#d6d1c7;margin:0 0 18px\">Un accès Perfect Models Management a été préparé pour vous. Cet espace vous permettra d’accéder aux informations et fonctionnalités qui vous sont attribuées.</p><p style=\"color:#aaa;margin:0 0 26px;font-size:14px\">Pour finaliser l’activation de votre compte, acceptez cette invitation à l’aide du bouton ci-dessous.</p><p style=\"text-align:center;margin:30px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c9a84c;color:#080808;text-decoration:none;font-weight:800;padding:15px 30px;border-radius:999px\">Activer mon espace</a></p><div style=\"background:#101010;border:1px solid #222;border-left:3px solid #c9a84c;border-radius:10px;padding:18px 20px\"><p style=\"margin:0;color:#aaa;font-size:13px\"><strong style=\"color:#ddd\">Important :</strong> cette invitation est strictement personnelle. Ne partagez ni le lien, ni vos futurs identifiants de connexion.</p></div><p style=\"margin:28px 0 0;color:#777;font-size:11px;word-break:break-all\">Lien direct : <a href=\"{{ .ConfirmationURL }}\" style=\"color:#c9a84c\">{{ .ConfirmationURL }}</a></p></td></tr><tr><td style=\"padding:24px;text-align:center;background:#070707;border-top:1px solid #191919;color:#666;font-size:11px\">Perfect Models Management · Libreville, Gabon</td></tr></table></td></tr></table></body></html>",

  "mailer_subjects_magic_link": "Votre accès sécurisé — Perfect Models Management",
  "mailer_templates_magic_link_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><div style=\"display:none;max-height:0;overflow:hidden\">Votre lien sécurisé et votre code temporaire de connexion PMM.</div><table width=\"100%\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:30px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"PMM\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div></td></tr><tr><td style=\"padding:42px 38px;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Connexion sécurisée</div><h1 style=\"color:#fff;font-size:28px;line-height:1.2;margin:0 0 18px\">Votre accès temporaire est prêt</h1><p style=\"color:#d6d1c7;margin:0 0 22px\">Vous avez demandé un accès à votre espace PMM. Utilisez le bouton ou le code ci-dessous pour poursuivre.</p><p style=\"text-align:center;margin:28px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c9a84c;color:#080808;text-decoration:none;font-weight:800;padding:15px 30px;border-radius:999px\">Accéder à mon compte</a></p><div style=\"margin:24px 0;background:#101010;border:1px solid #2b2416;border-radius:12px;padding:20px;text-align:center\"><div style=\"color:#888;font-size:11px;text-transform:uppercase;letter-spacing:2px;margin-bottom:10px\">Code à usage unique</div><div style=\"color:#c9a84c;font-size:34px;font-weight:800;letter-spacing:8px\">{{ .Token }}</div></div><div style=\"background:#101010;border-left:3px solid #c9a84c;border-radius:8px;padding:16px 18px\"><p style=\"margin:0;color:#aaa;font-size:13px\">Ce lien et ce code sont temporaires et personnels. Si vous n’avez pas demandé cette connexion, ignorez cet email.</p></div></td></tr><tr><td style=\"padding:24px;text-align:center;background:#070707;border-top:1px solid #191919;color:#666;font-size:11px\">Perfect Models Management · Sécurité du compte</td></tr></table></td></tr></table></body></html>",

  "mailer_subjects_recovery": "Réinitialisation de votre mot de passe — Perfect Models Management",
  "mailer_templates_recovery_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><div style=\"display:none;max-height:0;overflow:hidden\">Procédure sécurisée pour choisir un nouveau mot de passe PMM.</div><table width=\"100%\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:30px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"PMM\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div></td></tr><tr><td style=\"padding:42px 38px;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Récupération du compte</div><h1 style=\"color:#fff;font-size:28px;margin:0 0 18px\">Choisissez un nouveau mot de passe</h1><p style=\"color:#d6d1c7;margin:0 0 18px\">Une demande de réinitialisation a été reçue pour votre compte Perfect Models Management.</p><p style=\"color:#aaa;font-size:14px;margin:0 0 24px\">Cliquez sur le bouton ci-dessous pour ouvrir la procédure sécurisée et définir un nouveau mot de passe.</p><p style=\"text-align:center;margin:30px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c9a84c;color:#080808;text-decoration:none;font-weight:800;padding:15px 30px;border-radius:999px\">Réinitialiser mon mot de passe</a></p><div style=\"background:#120e0e;border:1px solid #3a2020;border-left:3px solid #c96f6f;border-radius:10px;padding:18px 20px\"><div style=\"color:#e5a0a0;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px\">Vous n’avez rien demandé ?</div><p style=\"margin:0;color:#aaa;font-size:13px\">Ignorez simplement cet email. Votre mot de passe actuel restera inchangé. Si vous remarquez une activité inhabituelle, contactez immédiatement l’administration.</p></div><p style=\"margin:26px 0 0;color:#777;font-size:11px;word-break:break-all\">Lien de secours : <a href=\"{{ .ConfirmationURL }}\" style=\"color:#c9a84c\">{{ .ConfirmationURL }}</a></p></td></tr><tr><td style=\"padding:24px;text-align:center;background:#070707;border-top:1px solid #191919;color:#666;font-size:11px\">Perfect Models Management · Protection de votre compte</td></tr></table></td></tr></table></body></html>",

  "mailer_subjects_email_change": "Confirmez votre nouvelle adresse email — Perfect Models Management",
  "mailer_templates_email_change_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><table width=\"100%\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:30px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"PMM\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div></td></tr><tr><td style=\"padding:42px 38px;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Modification du compte</div><h1 style=\"color:#fff;font-size:28px;margin:0 0 18px\">Confirmez votre nouvelle adresse email</h1><p style=\"color:#d6d1c7\">Vous avez demandé à utiliser l’adresse suivante pour votre compte :</p><div style=\"margin:20px 0;background:#101010;border:1px solid #2f2818;border-radius:10px;padding:16px 18px;color:#c9a84c;font-weight:700;word-break:break-all\">{{ .NewEmail }}</div><p style=\"color:#aaa;font-size:14px\">Confirmez cette modification pour terminer la mise à jour de votre compte.</p><p style=\"text-align:center;margin:30px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#c9a84c;color:#080808;text-decoration:none;font-weight:800;padding:15px 30px;border-radius:999px\">Confirmer cette adresse</a></p><div style=\"background:#101010;border-left:3px solid #c9a84c;border-radius:8px;padding:16px 18px;color:#aaa;font-size:13px\">Si vous n’êtes pas à l’origine de cette demande, ne cliquez pas sur le lien et contactez l’administration si nécessaire.</div></td></tr><tr><td style=\"padding:24px;text-align:center;background:#070707;border-top:1px solid #191919;color:#666;font-size:11px\">Perfect Models Management · Sécurité du compte</td></tr></table></td></tr></table></body></html>",

  "mailer_subjects_reauthentication": "{{ .Token }} — Votre code de sécurité PMM",
  "mailer_templates_reauthentication_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial,Helvetica,sans-serif;color:#f5f0e8\"><table width=\"100%\" style=\"background:#050505;padding:36px 14px\"><tr><td align=\"center\"><table width=\"620\" style=\"max-width:620px;width:100%;background:#0b0b0b;border:1px solid #2f2818;border-radius:18px;overflow:hidden\"><tr><td style=\"padding:30px;text-align:center;background:#080808;border-bottom:1px solid #2f2818\"><img src=\"https://perfectmodels.online/logo.svg\" width=\"58\" height=\"58\" alt=\"PMM\" style=\"display:block;margin:0 auto 14px\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:4px;text-transform:uppercase\">Perfect Models Management</div></td></tr><tr><td style=\"padding:42px 38px;text-align:center;line-height:1.75\"><div style=\"color:#c9a84c;font-size:11px;font-weight:800;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px\">Vérification renforcée</div><h1 style=\"color:#fff;font-size:28px;margin:0 0 16px\">Confirmez votre identité</h1><p style=\"color:#bdb7ac;margin:0 0 24px\">Une action sensible nécessite une vérification supplémentaire.</p><div style=\"display:inline-block;background:#101010;border:1px solid #2f2818;border-radius:14px;padding:20px 28px;margin:6px 0 24px\"><div style=\"color:#888;font-size:10px;text-transform:uppercase;letter-spacing:2px;margin-bottom:8px\">Code de vérification</div><div style=\"color:#c9a84c;font-size:38px;letter-spacing:9px;font-weight:800\">{{ .Token }}</div></div><p style=\"color:#777;font-size:12px;margin:0\">Ce code est confidentiel et temporaire. Aucun membre de PMM ne vous demandera de le communiquer.</p></td></tr><tr><td style=\"padding:24px;text-align:center;background:#070707;border-top:1px solid #191919;color:#666;font-size:11px\">Perfect Models Management · Vérification de sécurité</td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_password_changed_enabled": true,
  "mailer_subjects_password_changed_notification": "Sécurité : votre mot de passe a été modifié",
  "mailer_templates_password_changed_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Votre mot de passe a été modifié</h2><p style=\"color:#c8c2b7;line-height:1.7\">Le mot de passe associé à votre compte vient d’être changé avec succès.</p><div style=\"margin-top:24px;background:#120e0e;border-left:3px solid #c96f6f;padding:16px 18px;border-radius:8px;color:#bbb;font-size:13px\"><strong style=\"color:#e5a0a0\">Vous n’êtes pas à l’origine de cette modification ?</strong><br>Réinitialisez immédiatement votre mot de passe et contactez l’administration PMM.</div></td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_email_changed_enabled": true,
  "mailer_subjects_email_changed_notification": "Sécurité : votre adresse email a été modifiée",
  "mailer_templates_email_changed_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Votre adresse email a été modifiée</h2><p style=\"color:#c8c2b7;line-height:1.7\">L’adresse de connexion de votre compte est passée de :</p><p style=\"background:#101010;padding:14px;border-radius:8px;color:#aaa\">{{ .OldEmail }}</p><p style=\"text-align:center;color:#777\">vers</p><p style=\"background:#101010;padding:14px;border:1px solid #2f2818;border-radius:8px;color:#c9a84c;font-weight:700\">{{ .Email }}</p><div style=\"margin-top:24px;background:#120e0e;border-left:3px solid #c96f6f;padding:16px 18px;border-radius:8px;color:#bbb;font-size:13px\">Si vous n’avez pas demandé cette modification, contactez immédiatement l’administration PMM.</div></td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_phone_changed_enabled": true,
  "mailer_subjects_phone_changed_notification": "Sécurité : votre numéro de téléphone a été modifié",
  "mailer_templates_phone_changed_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Numéro de téléphone mis à jour</h2><p style=\"color:#c8c2b7;line-height:1.7\">Le numéro associé à votre compte est passé de <strong>{{ .OldPhone }}</strong> à <strong style=\"color:#c9a84c\">{{ .Phone }}</strong>.</p><div style=\"margin-top:24px;background:#120e0e;border-left:3px solid #c96f6f;padding:16px 18px;border-radius:8px;color:#bbb;font-size:13px\">Si cette modification ne vient pas de vous, sécurisez votre compte et contactez immédiatement l’administration.</div></td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_identity_linked_enabled": true,
  "mailer_subjects_identity_linked_notification": "Nouvelle méthode de connexion ajoutée à votre compte",
  "mailer_templates_identity_linked_notification_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#050505;font-family:Arial;color:#eee\"><table width=\"100%\" style=\"padding:32px 14px\"><tr><td align=\"center\"><table width=\"600\" style=\"max-width:600px;background:#0b0b0b;border:1px solid #2f2818;border-radius:16px\"><tr><td style=\"padding:28px;text-align:center;color:#c9a84c;font-size:11px;letter-spacing:4px;font-weight:800;border-bottom:1px solid #222\">PERFECT MODELS MANAGEMENT</td></tr><tr><td style=\"padding:38px\"><h2 style=\"color:#fff;margin-top:0\">Nouvelle méthode de connexion</h2><p style=\"color:#c8c2b7;line-height:1.7\">Le fournisseur <strong style=\"color:#c9a84c\">{{ .Provider }}</strong> vient d’être associé à votre compte {{ .Email }}.</p><p style=\"color:#888;font-size:13px\">Cette méthode pourra désormais être utilisée pour accéder à votre espace selon les paramètres de votre compte.</p></td></tr></table></td></tr></table></body></html>",

  "mailer_notifications_identity_unlinked_enabled": true,
