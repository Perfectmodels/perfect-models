{
  "rules": {
    ".read": true,
    ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

    "users": {
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "models": {
      "$modelId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('profileId').val() === $modelId)"
      }
    },

    "castingApplications": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'registration'))",
        ".validate": "!newData.exists() || (newData.hasChildren(['firstName','lastName','email','phone','status','submissionDate']) && newData.child('firstName').isString() && newData.child('lastName').isString() && newData.child('email').isString() && newData.child('phone').isString() && newData.child('status').isString() && newData.child('submissionDate').isString())"
      }
    },

    "fashionDayApplications": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "contactMessages": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || (newData.hasChildren(['name','email','subject','message','status','submissionDate']) && newData.child('name').isString() && newData.child('email').isString() && newData.child('subject').isString() && newData.child('message').isString())"
      }
    },

    "bookingRequests": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "!newData.exists() || (newData.hasChildren(['clientName','clientEmail','requestedModels','status','submissionDate']) && newData.child('clientName').isString() && newData.child('clientEmail').isString() && newData.child('requestedModels').isString())"
      }
    },

    "recoveryRequests": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "articleComments": {
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "forumThreads": {
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'student' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "forumReplies": {
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'student' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "missOneLight": {
      "pendingVotes": {
        "$voteId": {
          ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".validate": "!newData.exists() || (newData.hasChildren(['candidateId','candidateName','voterName','votes','totalVotes','email','phone','txRef','validated','timestamp']) && newData.child('candidateId').isString() && newData.child('candidateName').isString() && newData.child('voterName').isString() && newData.child('votes').isNumber() && newData.child('totalVotes').isNumber() && newData.child('email').isString() && newData.child('phone').isString() && newData.child('txRef').isString() && newData.child('validated').val() === false && newData.child('timestamp').isString())"
        }
      },
      "candidates": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      },
      "config": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },

    "gallery": {
      ".indexOn": "createdAt"
    },
    "galleryAlbums": {
      ".indexOn": "createdAt"
    }
  }
}
